# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Destination email where new lead notifications will be sent
NOTIFICATION_EMAIL="hello@faysela.com"

# --- Option A: RESEND (Recommended for Vercel Serverless) ---
# Sign up free at https://resend.com, generate an API key, and paste it here:
RESEND_API_KEY=
# Optional custom sender (leave empty or use onboarding@resend.dev until your custom domain is verified in Resend)
RESEND_FROM="BookedFlowOps <onboarding@resend.dev>"

# --- Option B: SMTP (e.g. Postmark, SendGrid, Amazon SES, Brevo, Gmail App Password) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="BookedFlowOps <notifications@bookedflowops.com>"

# --- Option C: Optional Webhook alerts (Discord, Slack, Zapier, Make) ---
WEBHOOK_URL=

