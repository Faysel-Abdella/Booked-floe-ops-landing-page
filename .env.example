# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Email Delivery Configuration (Optional - fallback to secure server logging and simulated dispatch if not provided)
# Target contact email where notifications are delivered: hello@faysela.com
NOTIFICATION_EMAIL="hello@faysela.com"

# SMTP Settings for live transactional email delivery (e.g., SendGrid, Postmark, AWS SES, Resend SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BookedFlowOps <notifications@bookedflowops.com>"

# Alternatively, Resend API key for direct HTTP email sending
RESEND_API_KEY=
